# Terraform state and backup files
*.tfstate
*.tfstate.*
crash.log
.terraform/
.terraform.lock.hcl

# Sensitive variable files
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Editor and OS files
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Shell history and logs
*.log
*.history

# SSH keys (if any are generated locally)
k8s-cluster-keys/

# --- GCP LinkForge lab -----------------------------------------------------
# Your personal settings file (contains your project ID, not a secret, but
# not something anyone else's copy of the repo should inherit).
scripts/env.sh

# Python
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/

# Rendered Kubernetes manifests, if you ever redirect deploy.sh output
k8s/rendered/
